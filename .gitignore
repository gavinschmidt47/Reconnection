# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Don't ignore .vcxproj files - include them in version control
!*.vcxproj
!*.vcxproj.filters

# Don't ignore .uproject files - these are essential!
!*.uproject

# Don't ignore Source files - these are essential for building!
!Source/
!Source/**/*.cs
!Source/**/*.cpp
!Source/**/*.h
!Source/**/*.Build.cs
!Source/**/*.Target.cs

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
*.ushaderbytecode
*.pdb

# Crash and log files
Reconnection/Saved/Crashes/
Reconnection/Saved/Config/CrashReportClient/
Reconnection/Saved/**/*.log
Reconnection/Saved/**/*.ini
Reconnection/Saved/**/*.xml
Reconnection/Build/**/*.log
Reconnection/Intermediate/**/*.log
Reconnection/Intermediate/**/*.xml
*.rsp
*.old

# Keep essential config files
!Config/
!Config/*.ini
!Reconnection/Config/*.ini
!Plugins/**/Config/
!Reconnection/Plugins/**/Config/*.ini
!Reconnection/.idea/**/*.xml
!Reconnection/.run/**/*.xml
/Reconnection/Intermediate/ProjectFiles/.Rider
